# Search-Want Environment Configuration Example
# Copy to backend/.env or frontend/.env when deploying to production

# PostgreSQL Database
SEARCH_WANT_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/search_want
SEARCH_WANT_SECRET_KEY=change-this-to-a-strong-production-secret

# Google AdSense Defaults (Can also be configured live in Admin Console: /admin/approvals?tab=ADSENSE)
SEARCH_WANT_ADSENSE_CLIENT_ID=ca-pub-4990570878383229
SEARCH_WANT_ADSENSE_SLOT_INFEED=6642734194
SEARCH_WANT_ADSENSE_SLOT_BANNER=8750022785

# Frontend Public Runtime Variables
NUXT_PUBLIC_API_BASE=
NUXT_PUBLIC_HTTPS_PORT=3443
NUXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-4990570878383229
NUXT_PUBLIC_ADSENSE_SLOT_INFEED=6642734194
NUXT_PUBLIC_ADSENSE_SLOT_BANNER=8750022785

