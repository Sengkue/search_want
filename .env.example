# Search-Want Environment Configuration Example
# Copy to backend/.env or frontend/.env when deploying to Production

# ==============================================================================
# 1. Production Security & RBAC Mode
# ==============================================================================
# Set to "production" on live servers to automatically:
# - Disable 1-click demo login buttons & block weak demo passwords (admin123/owner123/user123)
# - Block /api/shops/seed-nearby demo shop creation
# - Hide public /docs, /redoc, and /openapi.json API enumeration
# - Enforce >= 32-char SEARCH_WANT_SECRET_KEY validation
SEARCH_WANT_ENV=production
SEARCH_WANT_SECRET_KEY=replace-with-a-random-64-char-production-secret-key-2026-vientiane
SEARCH_WANT_TOKEN_EXPIRE_MINUTES=720
SEARCH_WANT_DEMO_MODE=false
SEARCH_WANT_ENABLE_DOCS=false
SEARCH_WANT_CORS_ORIGINS=https://your-domain.la,https://www.your-domain.la

# Bootstrap Real Production Super Admin Account (Created/Promoted automatically on startup)
SEARCH_WANT_SUPER_ADMIN_EMAIL=owner@your-domain.la
SEARCH_WANT_SUPER_ADMIN_PASSWORD=ReplaceWithStrongPassword2026!
SEARCH_WANT_SUPER_ADMIN_NAME=ຜູ້ບໍລິຫານສູງສຸດ

# ==============================================================================
# 2. PostgreSQL Database
# ==============================================================================
SEARCH_WANT_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/search_want

# ==============================================================================
# 3. Google AdSense Defaults (Managed strictly by SUPER_ADMIN at /admin/approvals?tab=ADSENSE)
# ==============================================================================
SEARCH_WANT_ADSENSE_CLIENT_ID=ca-pub-4990570878383229
SEARCH_WANT_ADSENSE_SLOT_INFEED=6642734194
SEARCH_WANT_ADSENSE_SLOT_BANNER=8750022785

# ==============================================================================
# 4. Frontend Public Runtime Variables
# ==============================================================================
NUXT_PUBLIC_API_BASE=
NUXT_PUBLIC_HTTPS_PORT=3443
NUXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-4990570878383229
NUXT_PUBLIC_ADSENSE_SLOT_INFEED=6642734194
NUXT_PUBLIC_ADSENSE_SLOT_BANNER=8750022785
